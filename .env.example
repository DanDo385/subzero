# ============================================================================
# subzero configuration: the full reference
#
# Every setting, explained. Do not put your values in this file.
#   Your values go in .env.local: run `uv run subzero init`,
#   or copy .env.local.example to .env.local and fill it in.
#   Settings are read from .env, then .env.local (which wins); a real
#   environment variable beats both.
#   Online, the same settings are copied to your host with deploy/vercel-env.sh.
# NEVER commit or share a filled-in .env.local.
# ============================================================================

# ---------------------------------------------------------------- deployment
SUBZERO_ENVIRONMENT=dev                  # dev | staging | prod
SUBZERO_LOG_LEVEL=INFO                   # DEBUG outside prod also logs raw MCP request bodies (your content)
SUBZERO_PORT=8080

# Public origin of this service. Must match what the AI providers dial, because
# it is the RFC 8707 resource identifier and the token audience.
SUBZERO_BASE_URL=http://localhost:8080

# Optional high-entropy path segment -> endpoint becomes /mcp/<server_id>.
# DEFENCE IN DEPTH ONLY. It is not authentication and the server behaves
# identically without it. Generate with: openssl rand -hex 16
SUBZERO_SERVER_ID=

# Hostnames this server will answer on (DNS-rebinding protection).
SUBZERO_ALLOWED_HOSTS=

# ------------------------------------------------------------------ database
# Supabase: Project settings -> Database -> Connection string -> URI.
# Use the pooler (port 6543) for serverless deployments.
SUBZERO_DATABASE_URL=postgresql://postgres:password@localhost:5432/subzero
SUBZERO_DB_POOL_MIN_SIZE=1
SUBZERO_DB_POOL_MAX_SIZE=10

# ---------------------------------------------------------------------- auth
# google  - OAuth 2.1 via your own Google OAuth app (recommended default).
#           Presents a DCR-compliant interface to MCP clients, which Grok
#           requires and the others prefer.
# github  - same pattern, GitHub upstream.
# jwt     - an external IdP that mints this server's capability scopes.
# static  - bearer tokens for local development. Refused when ENVIRONMENT=prod.
# none    - no auth at all. Refused when ENVIRONMENT=prod.
SUBZERO_AUTH_MODE=static

# THE most important line in this file. Only these identities may use the
# server; a valid token belonging to anyone else is rejected. Matched against
# the token's email and subject claims.
SUBZERO_ALLOWED_SUBJECTS=you@example.com

# Google Cloud console -> APIs & Services -> Credentials -> OAuth client ID
# (Web application). Authorised redirect URI: <SUBZERO_BASE_URL>/auth/callback
SUBZERO_OAUTH_CLIENT_ID=
SUBZERO_OAUTH_CLIENT_SECRET=
# Signs the tokens this server issues to MCP clients. openssl rand -hex 32
SUBZERO_OAUTH_SIGNING_KEY=

# auth_mode=jwt only
SUBZERO_JWT_JWKS_URI=
SUBZERO_JWT_ISSUER=
SUBZERO_JWT_AUDIENCE=

# auth_mode=static only (development). JSON: {"<token>": "<subject>"}
SUBZERO_STATIC_TOKENS={"dev-token-change-me":"you@example.com"}

# Capability scopes granted per MCP client, matched on its client id or on the
# app it is: chatgpt, claude, gemini or grok, recognised from the callback URL
# the app registered (never from the name it gave itself). "*" is the default
# for anything unmatched; with no policy at all, a new client gets READ-ONLY access.
#   "*"          every scope
#   "read"       every :read scope
# Example: full access everywhere, read-only for Grok.
SUBZERO_CLIENT_SCOPE_POLICY={"grok":["read"],"*":["*"]}

# Sign-in only sends codes to ChatGPT, Claude, Gemini and Grok's callback URLs
# and to this computer (localhost). To connect another app, add its callback
# URL here, comma-separated; * matches within the path. Usually left empty.
SUBZERO_ALLOWED_REDIRECT_URIS=

# Shared secret for the local Obsidian worker's outbound calls. Separate from
# MCP auth: the worker is your code, not a model. openssl rand -hex 32
SUBZERO_WORKER_API_KEY=

SUBZERO_RATE_LIMIT_PER_MINUTE=120
SUBZERO_RATE_LIMIT_BURST=40

# ------------------------------------------------------------------- storage
SUBZERO_STORAGE_BACKEND=local            # supabase | local
SUBZERO_SUPABASE_URL=https://<project-ref>.supabase.co
# Service-role key, NOT the anon key. Keep it server-side only.
SUBZERO_SUPABASE_SERVICE_KEY=
SUBZERO_SUPABASE_BUCKET=subzero
SUBZERO_SUPABASE_ARCHIVE_BUCKET=subzero-archives
SUBZERO_LOCAL_STORAGE_ROOT=.data/storage

SUBZERO_SIGNED_URL_TTL_SECONDS=900
SUBZERO_SIGNED_URL_TTL_SENSITIVE_SECONDS=120
SUBZERO_MAX_ARTIFACT_FILE_BYTES=104857600
SUBZERO_MAX_BUNDLE_FILES=500
SUBZERO_MAX_BUNDLE_BYTES=209715200

# Archive-bomb guards applied to provider export ZIPs.
SUBZERO_MAX_ARCHIVE_ENTRIES=50000
SUBZERO_MAX_ARCHIVE_UNCOMPRESSED_BYTES=4294967296
SUBZERO_MAX_ARCHIVE_COMPRESSION_RATIO=200

# ---------------------------------------------------------------- classifier
SUBZERO_CLASSIFIER=rules                 # jev | rules
# https://console.typesafe.ai/keys
SUBZERO_TYPESAFE_API_KEY=
SUBZERO_JEV_MODEL=jev-latest
SUBZERO_JEV_TIMEOUT_SECONDS=12
SUBZERO_JEV_MAX_RETRIES=2
SUBZERO_JEV_MAX_STATE_CHARS=48000
SUBZERO_JEV_MAX_PROJECT_CANDIDATES=40

# Confidence policy. Engineering defaults, meant to be tuned against your own
# results. See classifier/questions.py for the per-action multipliers.
SUBZERO_AUTO_ROUTE_CONFIDENCE=0.85
SUBZERO_REVIEW_CONFIDENCE=0.55
# Historical bulk imports are deliberately stricter and do not flood the vault.
SUBZERO_IMPORT_AUTO_ROUTE_CONFIDENCE=0.93
SUBZERO_IMPORT_PROMOTE_TO_VAULT=false
# Which imported conversations become vault notes (see `subzero vault-plan`):
# Jev's note-worthiness (or close-read) probability + a recency bonus that halves every
# SUBZERO_VAULT_RECENCY_HALFLIFE_DAYS must reach SUBZERO_VAULT_MIN_SCORE. Lower = more notes.
SUBZERO_VAULT_MIN_SCORE=0.45
SUBZERO_VAULT_RECENCY_BONUS=0.2
SUBZERO_VAULT_RECENCY_HALFLIFE_DAYS=90
# Every imported conversation starts at this sensitivity; the deterministic
# screen (importers/sensitivity.py) can only raise it - credentials, ID and
# card numbers -> highly_sensitive; health/legal/finance talk -> private.
# highly_sensitive here keeps an entire backfill inside the process.
SUBZERO_IMPORT_DEFAULT_SENSITIVITY=normal
SUBZERO_IMPORT_SENSITIVITY_SCREEN=true
SUBZERO_IMPORT_CONCURRENCY=4
# Answer identical classification input from the stored result.
SUBZERO_CLASSIFICATION_CACHE=true

# ---------------------------------------------------------------- extraction
# Pass 2 of the historical backfill (`subzero extract`): a
# frontier model reads the full transcript of conversations Jev marked
# deep_extraction=yes. Never runs on highly_sensitive conversations.
SUBZERO_EXTRACTION_PROVIDER=none         # none | anthropic
SUBZERO_ANTHROPIC_API_KEY=
SUBZERO_EXTRACTION_MODEL=claude-opus-5-5     # claude-sonnet-5 is cheaper for very large backfills
SUBZERO_EXTRACTION_MAX_TRANSCRIPT_CHARS=120000
SUBZERO_EXTRACTION_CONCURRENCY=3
# How likely (0-1) pass 1 must think a close reading is worthwhile.
SUBZERO_EXTRACTION_MIN_PROBABILITY=0.6

# ---------------------------------------------------------------- embeddings
# none -> full-text search only. Perfectly usable; nothing leaves the process.
SUBZERO_EMBEDDING_PROVIDER=none          # none | openai | gemini
SUBZERO_EMBEDDING_MODEL=text-embedding-3-small
SUBZERO_OPENAI_API_KEY=
SUBZERO_GEMINI_API_KEY=
# Sensitivity levels that must never reach an external embedding, classifier
# or extraction model. Comma-separated, e.g. private,highly_sensitive
SUBZERO_NO_EXTERNAL_SENSITIVITY=highly_sensitive

# ------------------------------------------------------- gemini drive digest
# For Gemini plans without custom apps (docs/guides/11-gemini-without-custom-apps.md):
# a weekly digest is pushed to one Google Doc that a Gemini Gem uses as knowledge.
# Google Cloud > Clients > Create client > Desktop app; scope drive.file only.
SUBZERO_GOOGLE_DRIVE_CLIENT_ID=
SUBZERO_GOOGLE_DRIVE_CLIENT_SECRET=
# Filled in by: uv run subzero gemini-sync authorize
SUBZERO_GOOGLE_DRIVE_REFRESH_TOKEN=
SUBZERO_GEMINI_DIGEST_DOC_NAME=Subzero (for Gemini)
SUBZERO_GEMINI_DIGEST_DAYS=14

# ----------------------------------------------------------------- AgentMail
# Optional. Leave empty to keep email in dry-run mode. No signup is required
# for dry runs. Get a key from AgentMail's console; store it in 1Password.
SUBZERO_AGENTMAIL_API_KEY=
# Existing sending inbox ID. The draft preview shows this sender for approval.
SUBZERO_AGENTMAIL_INBOX_ID=
# Grant email:send in SUBZERO_CLIENT_SCOPE_POLICY only to clients allowed to email.
# A policy of "*" includes this scope; unmatched clients remain read-only.

# ------------------------------------------------------------------ obsidian
SUBZERO_OBSIDIAN_ENABLED=true
# Files larger than this are linked from the vault, not copied into it.
SUBZERO_OBSIDIAN_MIRROR_MAX_MB=5

# ----------------------------------------------------------------- retrieval
SUBZERO_DEFAULT_TOKEN_BUDGET=2500
SUBZERO_CONTEXT_SEARCH_DEFAULT_LIMIT=10
SUBZERO_MEMORY_DEDUP_DISTANCE=0.08


# ============================================================================
# Local Obsidian sync worker (runs on your Mac, outbound only).
# Put these in the worker's own .env, not the server's.
# The prefix is OBSIDIAN_SYNC_, not OBSIDIAN_: a bare OBSIDIAN_VAULT_PATH
# is already exported by other tools on some machines and would silently
# redirect where this worker writes.
# ============================================================================
OBSIDIAN_SYNC_API_URL=https://your-service.run.app
OBSIDIAN_SYNC_API_KEY=                   # must equal SUBZERO_WORKER_API_KEY
OBSIDIAN_SYNC_WORKER_ID=macbook
OBSIDIAN_SYNC_VAULT_PATH=~/Obsidian/Vault
OBSIDIAN_SYNC_POLL_INTERVAL_SECONDS=20
OBSIDIAN_SYNC_BATCH_SIZE=10
OBSIDIAN_SYNC_WATCH_FOR_EDITS=true
OBSIDIAN_SYNC_DRY_RUN=false
