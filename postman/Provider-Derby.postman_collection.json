{
  "info": {
    "name": "Provider Derby",
    "description": "The same two JSON-RPC calls the race makes. The connection check is eth_blockNumber. The triggered act is eth_call getReserves() on the Uniswap V2 USDC/WETH pair (0xB4e16d0168e52d35CaCD2c6185b44281Ec28C9Dc, selector 0x0902f1ac).\n\nThe API key sits in the URL path. Use a local Postman environment, and do not sync a workspace that has sent these requests. Postman history can store the URL.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Alchemy eth_blockNumber",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {
          "mode": "raw",
          "raw": "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"eth_blockNumber\",\"params\":[]}"
        },
        "url": "https://eth-mainnet.g.alchemy.com/v2/{{alchemy_api_key}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
              "pm.test('block number', function () {",
              "  const body = pm.response.json();",
              "  pm.expect(body.result).to.be.a('string');",
              "  pm.expect(body.result.indexOf('0x')).to.eql(0);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Infura eth_blockNumber",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {
          "mode": "raw",
          "raw": "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"eth_blockNumber\",\"params\":[]}"
        },
        "url": "https://mainnet.infura.io/v3/{{infura_api_key}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
              "pm.test('block number', function () {",
              "  const body = pm.response.json();",
              "  pm.expect(body.result).to.be.a('string');",
              "  pm.expect(body.result.indexOf('0x')).to.eql(0);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Alchemy getReserves",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {
          "mode": "raw",
          "raw": "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"eth_call\",\"params\":[{\"to\":\"0xB4e16d0168e52d35CaCD2c6185b44281Ec28C9Dc\",\"data\":\"0x0902f1ac\"},\"latest\"]}"
        },
        "url": "https://eth-mainnet.g.alchemy.com/v2/{{alchemy_api_key}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
              "pm.test('reserves hex', function () {",
              "  const body = pm.response.json();",
              "  pm.expect(body.result).to.be.a('string');",
              "  pm.expect(body.result.length).to.be.above(60);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Infura getReserves",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {
          "mode": "raw",
          "raw": "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"eth_call\",\"params\":[{\"to\":\"0xB4e16d0168e52d35CaCD2c6185b44281Ec28C9Dc\",\"data\":\"0x0902f1ac\"},\"latest\"]}"
        },
        "url": "https://mainnet.infura.io/v3/{{infura_api_key}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
              "pm.test('reserves hex', function () {",
              "  const body = pm.response.json();",
              "  pm.expect(body.result).to.be.a('string');",
              "  pm.expect(body.result.length).to.be.above(60);",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
