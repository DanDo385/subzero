# For commands run from your computer against the production database:
# migrate, check, import, reclassify, review, extract, wiki. Either Supabase
# pooler string works (each migration is a single transaction).
#   op run --env-file=deploy/admin.env.op -- uv run subzero migrate
SUBZERO_ENVIRONMENT=dev
SUBZERO_BASE_URL="op://<vault>/<item-id>/Server/base_url"
SUBZERO_DATABASE_URL="op://<vault>/<item-id>/Supabase/database_url_session"
SUBZERO_AUTH_MODE=none
SUBZERO_STORAGE_BACKEND=supabase
SUBZERO_SUPABASE_URL="op://<vault>/<item-id>/Supabase/supabase_url"
SUBZERO_SUPABASE_SERVICE_KEY="op://<vault>/<item-id>/Supabase/supabase_service_key"
SUBZERO_SUPABASE_BUCKET=subzero
SUBZERO_SUPABASE_ARCHIVE_BUCKET=subzero-archives
SUBZERO_CLASSIFIER=jev
SUBZERO_TYPESAFE_API_KEY="op://<vault>/<typesafe-item-id>/credential"
SUBZERO_EMBEDDING_PROVIDER=none

# Pass-2 deep extraction (`subzero extract`), run from this Mac.
SUBZERO_EXTRACTION_PROVIDER=anthropic
SUBZERO_ANTHROPIC_API_KEY="op://<vault>/<anthropic-item-id>/credential"
SUBZERO_EXTRACTION_MODEL=claude-opus-5-5

# Gemini digest (docs/guides/11-gemini-without-custom-apps.md)
SUBZERO_GOOGLE_DRIVE_CLIENT_ID="op://<vault>/<item-id>/Google Drive/client_id"
SUBZERO_GOOGLE_DRIVE_CLIENT_SECRET="op://<vault>/<item-id>/Google Drive/client_secret"
SUBZERO_GOOGLE_DRIVE_REFRESH_TOKEN="op://<vault>/<item-id>/Google Drive/refresh_token"
