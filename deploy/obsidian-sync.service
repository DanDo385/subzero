[Unit]
Description=Subzero Obsidian sync worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/bin/uv run obsidian-sync run
WorkingDirectory=%h/subzero
Restart=on-failure
RestartSec=60
Environment="PATH=%h/.cargo/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin"

# Load environment from .env.local or 1Password
EnvironmentFile=-%h/subzero/.env.local

[Install]
WantedBy=default.target