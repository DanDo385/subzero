# Production environment for Vercel. References only - safe to commit.
# Resolved by `op run` in deploy/vercel-env.sh; values never touch disk.
# Copy to deploy/production.env.op and replace <vault>/<item-id> with your
# own 1Password item (see docs/guides/07-keep-secrets-in-1password.md).
SUBZERO_ENVIRONMENT=prod
SUBZERO_LOG_LEVEL=INFO
SUBZERO_BASE_URL="op://<vault>/<item-id>/Server/base_url"
SUBZERO_ALLOWED_HOSTS=memory.example.com

SUBZERO_DATABASE_URL="op://<vault>/<item-id>/Supabase/database_url_pooler"
# One connection per serverless instance; the Supabase pooler multiplexes.
SUBZERO_DB_POOL_MIN_SIZE=0
SUBZERO_DB_POOL_MAX_SIZE=3

SUBZERO_AUTH_MODE=google
SUBZERO_ALLOWED_SUBJECTS=you@example.com
SUBZERO_OAUTH_CLIENT_ID="op://<vault>/<item-id>/Google OAuth/google_client_id"
SUBZERO_OAUTH_CLIENT_SECRET="op://<vault>/<item-id>/Google OAuth/google_client_secret"
SUBZERO_OAUTH_SIGNING_KEY="op://<vault>/<item-id>/Server/oauth_signing_key"
SUBZERO_CLIENT_SCOPE_POLICY={"*":["*"]}
SUBZERO_WORKER_API_KEY="op://<vault>/<item-id>/Server/worker_api_key"

SUBZERO_STORAGE_BACKEND=supabase
SUBZERO_SUPABASE_URL="op://<vault>/<item-id>/Supabase/supabase_url"
SUBZERO_SUPABASE_SERVICE_KEY="op://<vault>/<item-id>/Supabase/supabase_service_key"
SUBZERO_SUPABASE_BUCKET=subzero
SUBZERO_SUPABASE_ARCHIVE_BUCKET=subzero-archives

SUBZERO_CLASSIFIER=jev
SUBZERO_TYPESAFE_API_KEY="op://<vault>/<typesafe-item-id>/credential"

SUBZERO_EMBEDDING_PROVIDER=none
SUBZERO_OBSIDIAN_ENABLED=true
