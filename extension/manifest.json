{
  "manifest_version": 3,
  "name": "Subzero",
  "version": "0.1.0",
  "description": "Captures AI chat sessions from Muse, Claude, ChatGPT, Gemini and Grok into your Subzero database.",
  "permissions": ["storage", "alarms", "sidePanel"],
  "host_permissions": [
    "https://claude.ai/*",
    "https://chatgpt.com/*",
    "https://gemini.google.com/*",
    "https://grok.com/*",
    "https://muse.ai/*",
    "http://localhost:8080/*",
    "https://mbp.tailfbd394.ts.net/*",
    "https://subzero-eta.vercel.app/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*",
        "https://chatgpt.com/*",
        "https://gemini.google.com/*",
        "https://grok.com/*",
        "https://muse.ai/*"
      ],
      "js": [
        "providers/claude.js",
        "providers/chatgpt.js",
        "providers/gemini.js",
        "providers/grok.js",
        "providers/muse.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Subzero"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}